# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Values are read by Utils/secrets.js via react-native-config.
# Leaving a key empty disables the matching feature instead of breaking the build.

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_AUTH_URL=
SPOTIFY_TOKEN_URL=
SPOTIFY_API_BASE_URL=

# Podcast Index
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Last.fm
LASTFM_API_KEY=
LASTFM_API_SECRET=
